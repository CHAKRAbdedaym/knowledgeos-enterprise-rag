{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "../../../frontend",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"]
    }
  },
  "include": ["KnowledgeAssistant.tsx"]
}
