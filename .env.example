# Local synthetic portfolio demo. Never upload genuine confidential material.
POSTGRES_PASSWORD=knowledgeos_local_demo
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos_local_demo@localhost:5433/knowledgeos
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledgeos
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=.model-cache
UPLOAD_DIR=uploads
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
# none returns real retrieved excerpts without claiming AI generation.
LLM_PROVIDER=none
# Set a supported model you have access to, then recreate the backend.
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# For Ollama running on the host, configure a reachable server URL.
OLLAMA_URL=http://host.docker.internal:11434
